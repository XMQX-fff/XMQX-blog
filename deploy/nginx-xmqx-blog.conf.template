# XMQX-blog：VitePress 静态站点。
#
# 由 deploy/install.sh 安装到 /etc/nginx/sites-available/xmqx-blog，
# 下面的 CSP 占位符会按构建产物里的内联脚本哈希自动替换，别手改这个文件。
#
# 站点是纯静态产物，没有任何后端/上传/动态接口，所以安全策略可以收得很死：
# 只读方法、禁目录列举、禁穿越/隐藏文件、限请求速率、全套安全响应头。

map $uri $xmqx_blog_cache_control {
	# 只有带内容哈希的产物才长期强缓存：文件名变了内容必然变了，immutable 安全。
	~^/assets/.+\.(?:js|mjs|css|woff2?|png|jpe?g|svg|gif|webp|json)$ "public, max-age=31536000, immutable";

	# 社交封面和站点图标：内容很少变，给一周强缓存，省得每次分享都重下一遍。
	~^/(?:og\.png|favicon\.svg)$ "public, max-age=604800";

# 其余一律 no-store（连存都不许存），包含所有 HTML 页面和 hashmap.json。
#
# 这里踩过两次坑，所以收紧到 no-store 而不是 no-cache：
#   1. 原先用 default 兜底 max-age=600，每个 HTML 页面被浏览器缓存 10 分钟。
#      页面里引用的是带哈希的样式表/脚本，缓存住旧 HTML 就等于把旧资源钉死。
#   2. 改成 no-cache 后仍可能命中已经存下来的旧副本 —— 而旧副本引用的是
#      早就被删除的 chunk 哈希，于是站内点击白屏、刷新才正常。
# no-store 从根上断掉这条路径。代价只是每次访问重新下几 KB 的 HTML，
# 真正占流量的 JS/CSS/字体仍然是 immutable 一年。
	default                                    "no-store";
}


server {
	listen 80;
	listen [::]:80;
	server_name xmqx.online www.xmqx.online;

	# ACME HTTP-01 续签用：Let's Encrypt 只走 80 端口验证域名，
	# 所以这一段必须在跳转 HTTPS 之前生效，否则证书续不上。
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type text/plain;
		try_files $uri =404;
		access_log off;
	}

	location / {
		return 301 https://xmqx.online$request_uri;
	}
}

# 注意：这里只管按域名进来的请求。没有匹配 server_name 的请求（比如直接
# 敲裸 IP）会落到本机 80 端口的 default_server，那是同机另一个项目的站点，
# 本模板不去抢 default_server —— 抢了等于替别人的应用改行为。
# 裸 IP 暴露的是那套应用自己的事，要收口应该由它自己处理。

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name xmqx.online www.xmqx.online;

	# www 与主域名指向同一份内容。统一 301 到主域名，搜索引擎只认一个地址，
	# 免得同一页被算成两份、权重分散。canonical 也只写主域名。
	if ($host = "www.xmqx.online") {
		return 301 https://xmqx.online$request_uri;
	}

	ssl_certificate     /etc/letsencrypt/live/xmqx.online/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/xmqx.online/privkey.pem;

	# TLS 参数收紧到 TLS 1.2+。1.0/1.1 没有任何浏览器还开着，留着只是给
	# BEAST/POODLE 这类问题留入口。会话复用和 0-RTT 都关掉。
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
	ssl_session_cache shared:XMQXSSL:10m;
	ssl_session_timeout 1d;
	ssl_session_tickets off;

	# 不开 OCSP stapling：Let's Encrypt 从 2024 年起签发的证书不再带
	# OCSP 地址（AIA 里只有 CA Issuers），stapling 无从谈起，只会每次
	# nginx -t 报一条 "no OCSP responder URL" 的告警。
	# 吊销状态靠 CT 日志 + 短有效期（90 天）兜底。

	root /data/XMQX-blog/docs/.vitepress/dist;
	index index.html;

	access_log /var/log/nginx/xmqx-blog.access.log;
	error_log  /var/log/nginx/xmqx-blog.error.log;

	# ---- 请求体 / 超时：掐掉慢速攻击和「超大 body 打满内存」型 DoS ----
	client_max_body_size 1m;
	client_body_timeout 10s;
	client_header_timeout 10s;
	send_timeout 20s;
	reset_timedout_connection on;
	keepalive_timeout 15s;
	keepalive_requests 100;

	# 不暴露 nginx 版本（http{} 里已全局 server_tokens off，这里再兜一层）
	server_tokens off;

	# 站点全是 UTF-8，顺手在响应头里带上 charset：
	# 少一层对响应头编码的猜测，也就少一类编码相关的坑。
	charset utf-8;

	# 不允许列目录
	autoindex off;

	# ---- 安全响应头 ----
	# 注意：add_header 只在「本层级没有其它 add_header」时才向下继承，
	# 所以下面所有 location 都不要再写 add_header，缓存头统一走上面的 map。
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header Content-Security-Policy "default-src 'self'; script-src 'self' @@CSP_SCRIPT_SRC@@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; child-src 'none'" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()" always;
	add_header Cross-Origin-Opener-Policy "same-origin" always;
	add_header Cross-Origin-Resource-Policy "same-origin" always;
	add_header X-Permitted-Cross-Domain-Policies "none" always;
	add_header X-Robots-Tag "index, follow" always;
	# 现代浏览器已废弃 X-XSS-Protection，显式置 0 免得老浏览器开启有 bug 的过滤
	add_header X-XSS-Protection "0" always;
	add_header Cache-Control $xmqx_blog_cache_control always;

	# 限流：静态站正常浏览一次页面也就十几个请求，这个阈值远高于真人，
	# 只用来挡脚本小子批量抓取。超了直接 429。
	limit_req zone=xmqx_blog burst=100 nodelay;
	limit_req_status 429;

	gzip on;
	gzip_vary on;
	gzip_min_length 1024;
	gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml font/woff2;

	# ---- 路由 ----
	location / {
		# 纯只读站点：除 GET/HEAD 外一律拒绝
		# （limit_except 只能写在 location 里，所以放这儿；
		#   下面几个正则 location 本来就全是 deny all，不受影响）
		limit_except GET {
			deny all;
		}

		# VitePress 产物：目录带 index.html，页面走 /path/ 形式；
		# 找不到就 404，不回落到首页（避免把不存在的 URL 伪装成正常页面）
		try_files $uri $uri/ $uri.html =404;
	}

	# 友好的 404 页面
	error_page 404 /404.html;

	# ---- 禁止访问的文件 ----
	# 隐藏文件（.git / .env / .npmrc / .htaccess …）
	location ~ (^|/)\. {
		deny all;
		access_log off;
		log_not_found off;
	}

	# 路径穿越兜底（nginx 本身会把 ../ 归一化，这里再加一道）
	location ~ \.\.?(?:/|$) {
		deny all;
		access_log off;
		log_not_found off;
	}

	# 构建产物里绝对不该出现的东西：source map、备份稿、源码、脚本、
	# 数据库、密钥、压缩包。真混进来了（构建脚本配错、误提交）一律挡在门外。
	location ~* \.(?:map|bak|old|orig|save|swp|swo|log|ini|conf|cfg|env|lock|sh|bash|zsh|py|rb|pl|php|cgi|lua|sql|db|sqlite|key|pem|p12|jks|keystore|psd|dwg|iso|zip|tar|tgz|gz|bz2|xz|7z|rar|jar|war|class|git)$ {
		deny all;
		access_log off;
		log_not_found off;
	}
}