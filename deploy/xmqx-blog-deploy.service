[Unit]
Description=XMQX-blog auto-deploy (fetch latest commit and redeploy the static site)
Documentation=file:///data/XMQX-blog/README.md
After=network-online.target nginx.service
Wants=network-online.target
# 和 nginx 一起起：站点依赖 nginx 才有意义
Requires=nginx.service

[Service]
Type=oneshot
# 刻意不用 root：能用普通用户做的事就不要 root。
# （install.sh 内部需要 sudo 写 /etc/nginx 和 reload nginx）
User=admin
Group=admin
WorkingDirectory=/data/XMQX-blog
ExecStart=/data/XMQX-blog/deploy/auto-deploy.sh

# 这套东西和同机的 novelcraft / bandgream 抢 CPU 和磁盘。
# 夜间自动部署跑在业务后面，万一有性能问题也不会把线上服务带下去。
Nice=10
IOSchedulingClass=idle

# 上限 10 分钟：npm ci + vitepress build 正常几十秒，网络卡死时别无限挂着占住 timer
TimeoutStartSec=600

# 只跑一次，失败了就等下一个周期（下次会再试一次新提交）。
# 不配 Restart：自动重启只会把同一个坏提交反复 build 一遍。

StandardOutput=journal
StandardError=journal
SyslogIdentifier=xmqx-blog-deploy

[Install]
WantedBy=multi-user.target